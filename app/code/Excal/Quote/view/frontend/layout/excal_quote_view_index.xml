<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="empty"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Excal_Quote::css/quote.css"/>
    </head>
    <body>
        <attribute name="class" value="excal-quote-print-page"/>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="excal.quote.view"
                   template="Excal_Quote::view/quote.phtml" cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">Excal\Quote\ViewModel\QuoteView</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
