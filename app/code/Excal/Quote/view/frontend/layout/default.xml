<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="minicart.addons">
            <block class="Magento\Framework\View\Element\Template" name="excal.quote.minicart.link"
                   template="Excal_Quote::cart/minicart_link.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Excal\Quote\ViewModel\Button</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceBlock name="header.links">
            <block class="Magento\Framework\View\Element\Html\Link\Current" name="excal.quote.header.link"
                   ifconfig="excal_quote/general/enabled" after="-">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">Official quotations</argument>
                    <argument name="path" xsi:type="string">quote/request</argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceBlock name="footer_links">
            <block class="Magento\Framework\View\Element\Html\Link\Current" name="excal.quote.footer.link"
                   ifconfig="excal_quote/general/enabled">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">Official quotations</argument>
                    <argument name="path" xsi:type="string">quote/request</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
